APP_NAME=Confiq
APP_VERSION=0.1.0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
HOST=0.0.0.0
PORT=8089
DATABASE_PATH=data/confiq.db
JWT_SECRET=change-me
JWT_EXPIRE=2h
LOG_LEVEL=info
# В Docker путь /app/backups монтируется как ./backups на хосте
BACKUP_DIR=/app/backups
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
BACKUP_KEEP=7
BACKUP_SAFETY_ON_RESTORE=true
OTP_USER=false
OTP_ADMIN=true
#frontend runtime config (inserted into already-built frontend image)
DONATE_YOOMONEY_URL=https://yoomoney.ru/to/1234567891234567
DONATE_CLOUDTIP_URL=https://pay.cloudtips.ru/p/123abc456